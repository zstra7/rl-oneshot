# Online multiplayer (plan/ONLINE_MULTIPLAYER_PLAN.md, N4/N8).
# Base URL of the deployed Cloudflare control-plane Worker (rooms +
# matchmaking + signaling). Use a wss:// URL in production.
#
# If unset, the client falls back to same-origin ws(s)://<host>/api — use
# that when the SPA is served from the same Worker (Workers Assets).
#
# Local development against `cd backend && wrangler dev`:
#   VITE_MP_CONTROL_URL=ws://127.0.0.1:8787
VITE_MP_CONTROL_URL=
